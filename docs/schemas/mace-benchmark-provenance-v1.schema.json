{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qcmlforge.invalid/schemas/mace-benchmark-provenance-v1.schema.json",
  "title": "QCMLForge MACE-AP3D3 dataset provenance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "approved_by", "pair", "atomic"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "approved"},
    "approved_by": {"type": "string", "minLength": 1},
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_type",
        "target_method",
        "component_order",
        "columns",
        "units",
        "license",
        "files"
      ],
      "properties": {
        "spec_type": {"const": 2},
        "target_method": {"type": "string", "minLength": 1},
        "component_order": {"const": ["elst", "exch", "indu", "disp"]},
        "columns": {
          "const": ["Total_aug", "Elst_aug", "Exch_aug", "Ind_aug", "Disp_aug"]
        },
        "units": {"const": "kcal/mol"},
        "license": {"type": "string", "minLength": 1},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "test"],
          "properties": {
            "train": {"$ref": "#/$defs/sha256"},
            "test": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "atomic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_method", "properties", "units", "license", "files"],
      "properties": {
        "target_method": {"const": "PBE0/MBIS"},
        "properties": {"const": ["q", "mu", "quadrupole"]},
        "units": {"const": ["e", "e·bohr", "e·bohr²"]},
        "license": {"type": "string", "minLength": 1},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec_1", "spec_5"],
          "properties": {
            "spec_1": {"$ref": "#/$defs/sha256"},
            "spec_5": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
